/* Surgical navigation console theme */

QMainWindow {
    background: #0b1018;
}

QWidget {
    color: #dce7ef;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 12px;
}

QFrame#SidePanel {
    background: #111824;
    border: 1px solid #233247;
    border-radius: 8px;
}

QFrame#ViewportPanel {
    background: #05070a;
    border: 1px solid #26354c;
    border-radius: 8px;
}

QFrame#MetricCard, QFrame#StatusCard {
    background: #151f2d;
    border: 1px solid #2a3a50;
    border-radius: 6px;
}

QGroupBox {
    background: #151d2a;
    border: 1px solid #2a3a50;
    border-radius: 7px;
    margin-top: 14px;
    padding: 12px 8px 8px 8px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #70d6ff;
    background: #111824;
    letter-spacing: 0px;
}

QLabel {
    color: #dce7ef;
}

QLabel[role="muted"] {
    color: #8090a3;
    font-size: 11px;
}

QLabel[role="value"] {
    color: #45d7ff;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 13px;
    font-weight: 700;
}

QLabel[role="ok"] {
    color: #58d68d;
    font-weight: 700;
}

QLabel[role="warn"] {
    color: #f4c430;
    font-weight: 700;
}

QLabel[role="danger"] {
    color: #ff6b6b;
    font-weight: 700;
}

QPushButton {
    min-height: 28px;
    background: #1b2636;
    color: #eaf3f8;
    border: 1px solid #334862;
    border-radius: 5px;
    padding: 6px 10px;
    font-weight: 600;
}

QPushButton:hover {
    background: #24344a;
    border-color: #4f6e92;
}

QPushButton:pressed {
    background: #172231;
    padding-top: 7px;
    padding-bottom: 5px;
}

QPushButton:disabled {
    background: #111722;
    color: #5e6b79;
    border-color: #202b3a;
}

QPushButton[variant="primary"] {
    background: #1f9d63;
    border-color: #2ecf83;
    color: #ffffff;
}

QPushButton[variant="primary"]:hover {
    background: #24b574;
}

QPushButton[variant="danger"] {
    background: #c94a5a;
    border-color: #f06b7b;
    color: #ffffff;
}

QPushButton[variant="danger"]:hover {
    background: #dd596a;
}

QPushButton[variant="secondary"] {
    background: #22314a;
    border-color: #3b5378;
}

QComboBox, QDoubleSpinBox, QSpinBox, QLineEdit {
    min-height: 26px;
    background: #0d141f;
    color: #eaf3f8;
    border: 1px solid #2e415a;
    border-radius: 5px;
    padding: 4px 8px;
}

QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus, QLineEdit:focus {
    border-color: #45d7ff;
}

QCheckBox {
    color: #dce7ef;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #415a78;
    border-radius: 3px;
    background: #0d141f;
}

QCheckBox::indicator:checked {
    background: #45d7ff;
    border-color: #45d7ff;
}

QProgressBar {
    height: 16px;
    background: #0d141f;
    border: 1px solid #2e415a;
    border-radius: 5px;
    color: #dce7ef;
    text-align: center;
}

QProgressBar::chunk {
    background: #45d7ff;
    border-radius: 4px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 4px 0;
}

QScrollBar::handle:vertical {
    min-height: 32px;
    background: #2a3a50;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #405978;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QSplitter::handle {
    background: #0b1018;
    width: 8px;
}
