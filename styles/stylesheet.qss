/* ===== 全局暗色主题 ===== */

QMainWindow {
    background: #0d0d1a;
}

QFrame, QWidget {
    background: transparent;
}

/* ---- GroupBox 统一样式 ---- */

QGroupBox {
    font-weight: bold;
    border: 1px solid #3a3a5a;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 10px;
    background: #1e1e2e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #81d4fa;
}

/* ---- 通用控件 ---- */

QLabel {
    color: #e0e0e0;
    font-size: 12px;
}

/* 标签组标题淡化 */
QLabel.label-subtle {
    color: #888;
    font-size: 10px;
}

/* 数据值使用较大字体 */
QLabel.label-value {
    color: #4fc3f7;
    font-family: Consolas, monospace;
    font-size: 13px;
}

/* 关键数据高亮 */
QLabel.label-emphasis {
    color: #ff9800;
    font-family: Consolas, monospace;
    font-size: 15px;
    font-weight: bold;
}

QPushButton {
    background: #2a2a4a;
    color: white;
    border: 1px solid #4a4a6a;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background: #3a3a5a;
}

QPushButton:pressed {
    background: #4a4a6a;
}

QPushButton:disabled {
    background: #1a1a2a;
    color: #666;
    border-color: #333;
}

QDoubleSpinBox, QSpinBox {
    background: #2a2a4a;
    color: white;
    border: 1px solid #4a4a6a;
    border-radius: 4px;
    padding: 4px;
}

/* ---- 分隔条 ---- */

QSplitter::handle {
    background: #2a2a4a;
    width: 3px;
}

/* ---- 进度条 ---- */

QProgressBar {
    background: #2a2a4a;
    border: 1px solid #4a4a6a;
    border-radius: 4px;
    text-align: center;
    color: white;
    height: 18px;
}

QProgressBar::chunk {
    background: #4fc3f7;
    border-radius: 3px;
}

/* ---- 复选框 ---- */

QCheckBox {
    color: #e0e0e0;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #4a4a6a;
    border-radius: 3px;
    background: #2a2a4a;
}

QCheckBox::indicator:checked {
    background: #4fc3f7;
}
